[Unit]
Description=indiek Instagram scheduled publishing
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/indiek
ExecStart=/usr/bin/node %h/projects/indiek/scripts/promotion/run.mjs publish instagram
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
