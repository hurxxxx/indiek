[Unit]
Description=indiek weekly promotion report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/indiek
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node %h/projects/indiek/scripts/promotion/run.mjs weekly
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
