[Unit]
Description=indiek reviewed magazine publication
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/indiek
Environment=PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=INDIEK_EDITORIAL_SERVER=1
ExecStart=/usr/bin/node scripts/editorial/run.mjs run
TimeoutStartSec=3h
KillMode=control-group
UMask=0077
