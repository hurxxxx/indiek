[Unit]
Description=indiek Threads replies and conversation discovery (official API, growth plan W8)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/indiek
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node %h/projects/indiek/scripts/promotion/run.mjs engage run
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
